# 复制为 .env 并填写真实值（.env 已被 git 忽略，不会随代码更新被覆盖）

# 代理共享令牌：生成 openssl rand -hex 32，
# 须与 DFApp.Web 数据库配置（AppConfigurationInfo 的 LotteryProxyToken）一致
LOTTERY_PROXY_TOKEN=

# IP 白名单：填 DFApp.Web 服务器的公网 IP；多个 IP 需在本文件加不了，得在
# docker-compose.yml 追加 ProxySettings__AllowedIPs__1=${LOTTERY_ALLOWED_IP2:-} 之类的行
LOTTERY_ALLOWED_IP=

