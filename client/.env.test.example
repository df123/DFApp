# 测试环境配置模板；真实环境请复制为 .env.test 并填写密钥

# 平台本地运行端口号
VITE_PORT = 9949

# 测试环境静态资源路径
VITE_PUBLIC_PATH = /

# 路由历史模式
VITE_ROUTER_HISTORY = "h5"

# 后端 API 与认证服务器地址
VITE_API_BASE_URL = "http://localhost:44369"
VITE_AUTH_AUTHORITY = "http://localhost:44369"

# OAuth 客户端配置；客户端密钥必须由部署环境提供，禁止提交
VITE_OAUTH_CLIENT_ID = "DFApp_Web"
VITE_OAUTH_CLIENT_SECRET = ""

NODE_ENV = "test"
