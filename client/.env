# 平台本地运行端口号
VITE_PORT = 9949

# 本地开发路由历史模式（与生产保持一致使用 HTML5 模式）
VITE_ROUTER_HISTORY = "h5"

# 本地开发公共路径
VITE_PUBLIC_PATH = /

# 是否在打包时使用cdn替换本地库
VITE_CDN = false

# 压缩方式（开发环境不压缩）
VITE_COMPRESSION = "none"

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false

# API 基础 URL
VITE_API_BASE_URL = http://localhost:44369

# 认证服务器 URL
VITE_AUTH_AUTHORITY = http://localhost:44369
